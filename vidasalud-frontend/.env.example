# ─────────────────────────────────────────────────────────────
# Plantilla de configuración del frontend.
# Para desarrollo local (npm run dev) usa http://localhost:5173.
# Para el deploy en AWS estos valores se pasan en el build  del
# contenedor (docker-compose → build args), NO se editan aquí.
# ─────────────────────────────────────────────────────────────

# ── API ─────────────────────────────────────────────
# Dev:
#   VITE_API_URL=http://localhost:8080/api
# AWS (con API Gateway como API Manager):
#   VITE_API_URL=https://<API_ID>.execute-api.us-east-1.amazonaws.com/prod/api
VITE_API_URL=http://localhost:8080/api

# `true` sirve datos simulados (demo sin backend). `false` consume la API real.
VITE_USE_MOCKS=true

# Recursos que consumen el backend real (microservicios Spring Boot) incluso
# cuando VITE_USE_MOCKS=true. El resto (centros, boxes, cupos, dashboard,
# reportes, auditoría, login tradicional) sigue con datos demo.
VITE_USE_API_PRESTACIONES=true
VITE_USE_API_ATENCIONES=true

# ── Azure AD / Entra ID (IdaaS) ─────────────────────
# App Registration del SPA en Azure Portal (Overview de la app).
VITE_MSAL_CLIENT_ID=ec60a5af-ab77-42a4-b963-1e384c17be05
VITE_MSAL_TENANT_ID=a02c872a-3746-4efc-a2e3-1f8e608b99e4

# Dev:        http://localhost:5173
# AWS (EC2):  https://vidasalud.duckdns.org  ← también debe registrarse como
#             Redirect URI en la App Registration del SPA en Azure Portal.
VITE_MSAL_REDIRECT_URI=https://vidasalud.duckdns.org

# Scopes requeridos por el backend/API Gateway (separados por coma).
# api://6db95f4d-96a5-47ca-bc8e-e43bd5eda9ab/access_as_user es el scope
# expuesto por la App Registration de la API en "Expose an API".
VITE_MSAL_SCOPES=openid,profile,email,api://6db95f4d-96a5-47ca-bc8e-e43bd5eda9ab/access_as_user

# Si no hay credenciales Azure configuradas, el botón MSAL queda deshabilitado
# y se puede iniciar sesión con el login tradicional (usuario demo de los mocks).