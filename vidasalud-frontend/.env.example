# ── API ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api

# `true` sirve datos simulados (demo sin backend). `false` consume la API real.
VITE_USE_MOCKS=true

# Recursos que consumen el backend real (microservicios Spring Boot) incluso
# cuando VITE_USE_MOCKS=true. Actívalos solo si los microservicios están
# corriendo y se inicia sesión con Microsoft (token válido de Azure AD).
VITE_USE_API_PRESTACIONES=false
VITE_USE_API_ATENCIONES=false

# ── Azure AD / MSAL ─────────────────────────────────
# Valores de la App Registration en Azure Portal:
#   Authorization → App registrations → (tu app) → Overview
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173
# Scopes requeridos por el backend/API Gateway (separados por coma).
# Incluye el scope expuesto por la API (api://6db95f4d-96a5-47ca-bc8e-e43bd5eda9ab/access_as_user)
# que el BFF y los microservicios validarán (audiencia api://6db95f4d-96a5-47ca-bc8e-e43bd5eda9ab).
VITE_MSAL_SCOPES=openid,profile,email,api://6db95f4d-96a5-47ca-bc8e-e43bd5eda9ab/access_as_user