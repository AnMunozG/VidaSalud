# ── API ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api

# `true` sirve datos simulados (demo sin backend). `false` consume la API real.
VITE_USE_MOCKS=true

# ── Azure AD / MSAL ─────────────────────────────────
# Valores de la App Registration en Azure Portal:
#   Authorization → App registrations → (tu app) → Overview
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173
# Scopes requeridos por el backend/API Gateway (separados por coma).
# Por ahora: login de la app sin API publicada. Cuando el backend exista,
# cambia a api://vidasalud/access_as_user (con la API expuesta y consentida).
VITE_MSAL_SCOPES=openid,profile,email