# Variables para el compose de la EC2 VidaSalud.
# Copiar a .env y ajustar

# IP privada de la EC2 B (RabbitMQ + ms-vidasalud-notify).
# Debe coincidir con las credenciales de infra/notify/.env de la EC2 Notify.
RABBITMQ_HOST=172.31.27.83
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=vidasalud
RABBITMQ_PASSWORD=cambia-esta-clave
